#!/usr/bin/env bash

# Mussel Podman Wrapper Script
# This script provides seamless CLI usage of Mussel through Podman

set -e

# Configuration
PODMAN_IMAGE="${MUSSEL_PODMAN_IMAGE:-mussel:latest}"
BACKEND="${MUSSEL_BACKEND:-torch-gpu}"
USE_GPU="${MUSSEL_USE_GPU:-true}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Available Mussel commands
MUSSEL_COMMANDS=(
    "tessellate"
    "tessellate_extract_features"
    "filter_tessellate"
    "extract_features"
    "create_class_embeddings"
    "annotate"
    "cache_tiles"
    "export_tiles"
    "filter_features"
    "merge_annotation_features"
    "linear_probe_benchmark"
    "save_model"
)

# Help message
show_help() {
    cat << EOF
Mussel Podman Wrapper

Usage: $(basename "$0") COMMAND [OPTIONS]

Available Commands:
    tessellate                  - Tile whole-slide images with foreground detection
    tessellate_extract_features - Combined tessellation and feature extraction
    filter_tessellate           - Filter tessellated patches
    extract_features            - Extract feature embeddings using foundation models
    create_class_embeddings     - Generate tissue-type embeddings
    annotate                    - Annotate tiles with tissue types
    cache_tiles                 - Cache tiles in efficient format
    export_tiles                - Export tiles as individual PNG files
    filter_features             - Filter features using a classifier
    merge_annotation_features   - Merge tile features with BMP annotations
    linear_probe_benchmark      - Benchmark linear probe classifiers
    save_model                  - Download and save foundation models
    
    build                       - Build the Podman image
    shell                       - Start an interactive shell in the container
    help                        - Show this help message

Environment Variables:
    MUSSEL_PODMAN_IMAGE         - Podman image name (default: mussel:latest)
    MUSSEL_BACKEND              - Backend to use: torch-gpu, torch-cpu, 
                                  tensorflow-gpu, tensorflow-cpu (default: torch-gpu)
    MUSSEL_USE_GPU              - Enable GPU support: true/false (default: true)
    MUSSEL_WORK_DIR             - Working directory to mount (default: current directory)

Examples:
    # Build the Podman image
    $(basename "$0") build

    # Tile a whole-slide image
    $(basename "$0") tessellate slide_path=slide.svs output_h5_path=tiles.h5

    # Extract features
    $(basename "$0") extract_features slide_path=slide.svs patch_h5_path=tiles.h5 \\
        model_type=CLIP output_h5_path=features.h5

    # Start an interactive shell
    $(basename "$0") shell

    # Use CPU-only backend
    MUSSEL_BACKEND=torch-cpu MUSSEL_USE_GPU=false $(basename "$0") tessellate --help

For more information, visit: https://github.com/pathology-data-mining/Mussel

EOF
}

# Check if Podman is installed
check_podman() {
    if ! command -v podman &> /dev/null; then
        echo -e "${RED}Error: Podman is not installed or not in PATH${NC}" >&2
        echo "Please install Podman from https://podman.io/getting-started/installation" >&2
        exit 1
    fi
}

# Build Podman image
build_image() {
    echo -e "${GREEN}Building Mussel Podman image...${NC}"
    echo "Backend: $BACKEND"
    echo "Image: $PODMAN_IMAGE"
    
    podman build \
        --build-arg BACKEND="$BACKEND" \
        -t "$PODMAN_IMAGE" \
        .
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}Successfully built $PODMAN_IMAGE${NC}"
    else
        echo -e "${RED}Failed to build Podman image${NC}" >&2
        exit 1
    fi
}

# Check if image exists
check_image() {
    if ! podman image inspect "$PODMAN_IMAGE" &> /dev/null; then
        echo -e "${YELLOW}Podman image '$PODMAN_IMAGE' not found${NC}" >&2
        echo "Building the image..." >&2
        build_image
    fi
}

# Start interactive shell
start_shell() {
    check_image
    
    local work_dir="${MUSSEL_WORK_DIR:-$(pwd)}"
    local podman_args="-it --rm"
    
    # Add GPU support if requested
    if [ "$USE_GPU" = "true" ]; then
        # Check if nvidia-ctk or nvidia-container-toolkit is available
        if command -v nvidia-ctk &> /dev/null || [ -f /usr/bin/nvidia-container-runtime ]; then
            # Try CDI (Container Device Interface) first (Podman 4.1+)
            if podman run --rm --device nvidia.com/gpu=all ubuntu:22.04 nvidia-smi &> /dev/null 2>&1; then
                podman_args="$podman_args --device nvidia.com/gpu=all"
            # Fallback to --security-opt=label=disable approach
            elif podman run --rm --security-opt=label=disable --device /dev/dri ubuntu:22.04 ls /dev/dri &> /dev/null 2>&1; then
                podman_args="$podman_args --security-opt=label=disable"
                # Add all GPU devices
                for dev in /dev/nvidia* /dev/dri/*; do
                    [ -e "$dev" ] && podman_args="$podman_args --device $dev"
                done
            else
                echo -e "${YELLOW}Warning: GPU support requested but not available${NC}" >&2
            fi
        else
            echo -e "${YELLOW}Warning: GPU support requested but nvidia-container-toolkit not found${NC}" >&2
        fi
    fi
    
    echo -e "${GREEN}Starting interactive shell...${NC}"
    echo "Working directory: $work_dir"
    
    podman run $podman_args \
        -v "$work_dir:/data:Z" \
        -w /data \
        "$PODMAN_IMAGE" \
        /bin/bash
}

# Run a Mussel command
run_command() {
    local command=$1
    shift
    
    check_image
    
    local work_dir="${MUSSEL_WORK_DIR:-$(pwd)}"
    local podman_args="--rm"
    
    # Add GPU support if requested
    if [ "$USE_GPU" = "true" ]; then
        # Check if nvidia-ctk or nvidia-container-toolkit is available
        if command -v nvidia-ctk &> /dev/null || [ -f /usr/bin/nvidia-container-runtime ]; then
            # Try CDI (Container Device Interface) first (Podman 4.1+)
            if podman run --rm --device nvidia.com/gpu=all ubuntu:22.04 nvidia-smi &> /dev/null 2>&1; then
                podman_args="$podman_args --device nvidia.com/gpu=all"
            # Fallback to --security-opt=label=disable approach
            elif podman run --rm --security-opt=label=disable --device /dev/dri ubuntu:22.04 ls /dev/dri &> /dev/null 2>&1; then
                podman_args="$podman_args --security-opt=label=disable"
                # Add all GPU devices
                for dev in /dev/nvidia* /dev/dri/*; do
                    [ -e "$dev" ] && podman_args="$podman_args --device $dev"
                done
            else
                echo -e "${YELLOW}Warning: GPU support requested but not available, running on CPU${NC}" >&2
            fi
        else
            echo -e "${YELLOW}Warning: GPU support requested but nvidia-container-toolkit not found, running on CPU${NC}" >&2
        fi
    fi
    
    # Run the command
    podman run $podman_args \
        -v "$work_dir:/data:Z" \
        -w /data \
        "$PODMAN_IMAGE" \
        uv run "$command" "$@"
}

# Main script logic
main() {
    check_podman
    
    # Handle no arguments
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi
    
    local command=$1
    shift
    
    case "$command" in
        help|--help|-h)
            show_help
            ;;
        build)
            build_image
            ;;
        shell)
            start_shell
            ;;
        tessellate|tessellate_extract_features|filter_tessellate|extract_features|create_class_embeddings|annotate|cache_tiles|export_tiles|filter_features|merge_annotation_features|linear_probe_benchmark|save_model)
            run_command "$command" "$@"
            ;;
        *)
            echo -e "${RED}Error: Unknown command '$command'${NC}" >&2
            echo "Run '$(basename "$0") help' for usage information" >&2
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
