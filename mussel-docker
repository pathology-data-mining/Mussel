#!/usr/bin/env bash

# Mussel Docker Wrapper Script
# This script provides seamless CLI usage of Mussel through Docker

set -e

# Configuration
DOCKER_IMAGE="${MUSSEL_DOCKER_IMAGE:-mussel:latest}"
BACKEND="${MUSSEL_BACKEND:-torch-gpu}"
USE_GPU="${MUSSEL_USE_GPU:-true}"
SHM_SIZE="${MUSSEL_SHM_SIZE:-2g}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Environment Variables to pass to container
ENV_VARS=(
  "HF_TOKEN"
  "AWS_ACCESS_KEY_ID"
  "AWS_SECRET_ACCESS_KEY"
  "AWS_DEFAULT_REGION"
)

docker_env_args=""
for var in "${ENV_VARS[@]}"; do
  if [ -n "${!var}" ]; then
    docker_env_args="$docker_env_args -e $var=${!var}"
  fi
done

# Available Mussel commands
MUSSEL_COMMANDS=(
  "tessellate"
  "tessellate_extract_features"
  "filter_tessellate"
  "extract_features"
  "create_class_embeddings"
  "annotate"
  "cache_tiles"
  "export_tiles"
  "filter_features"
  "merge_annotation_features"
  "linear_probe_benchmark"
  "save_model"
)

# Help message
show_help() {
  cat <<EOF
Mussel Docker Wrapper

Usage: $(basename "$0") COMMAND [OPTIONS]

Available Commands:
    tessellate                  - Tile whole-slide images with foreground detection
    tessellate_extract_features - Combined tessellation and feature extraction
    filter_tessellate           - Filter tessellated patches
    extract_features            - Extract feature embeddings using foundation models
    create_class_embeddings     - Generate tissue-type embeddings
    annotate                    - Annotate tiles with tissue types
    cache_tiles                 - Cache tiles in efficient format
    export_tiles                - Export tiles as individual PNG files
    filter_features             - Filter features using a classifier
    merge_annotation_features   - Merge tile features with BMP annotations
    linear_probe_benchmark      - Benchmark linear probe classifiers
    save_model                  - Download and save foundation models
    
    build                       - Build the Docker image
    shell                       - Start an interactive shell in the container
    help                        - Show this help message

Environment Variables:
    MUSSEL_DOCKER_IMAGE         - Docker image name (default: mussel:latest)
    MUSSEL_BACKEND              - Backend to use: torch-gpu, torch-cpu, 
                                  tensorflow-gpu, tensorflow-cpu (default: torch-gpu)
    MUSSEL_USE_GPU              - Enable GPU support: true/false (default: true)
    MUSSEL_WORK_DIR             - Working directory to mount (default: current directory)

Examples:
    # Build the Docker image
    $(basename "$0") build

    # Tile a whole-slide image
    $(basename "$0") tessellate slide_path=slide.svs output_h5_path=tiles.h5

    # Extract features
    $(basename "$0") extract_features slide_path=slide.svs patch_h5_path=tiles.h5 \\
        model_type=CLIP output_h5_path=features.h5

    # Start an interactive shell
    $(basename "$0") shell

    # Use CPU-only backend
    MUSSEL_BACKEND=torch-cpu MUSSEL_USE_GPU=false $(basename "$0") tessellate --help

For more information, visit: https://github.com/pathology-data-mining/Mussel

EOF
}

# Check if Docker is installed
check_docker() {
  if ! command -v docker &>/dev/null; then
    echo -e "${RED}Error: Docker is not installed or not in PATH${NC}" >&2
    echo "Please install Docker from https://docs.docker.com/get-docker/" >&2
    exit 1
  fi
}

# Check if Docker daemon is running
check_docker_daemon() {
  if ! docker info &>/dev/null; then
    echo -e "${RED}Error: Docker daemon is not running${NC}" >&2
    echo "Please start Docker and try again" >&2
    exit 1
  fi
}

# Build Docker image
build_image() {
  echo -e "${GREEN}Building Mussel Docker image...${NC}"
  echo "Backend: $BACKEND"
  echo "Image: $DOCKER_IMAGE"

  docker build \
    --build-arg BACKEND="$BACKEND" \
    -t "$DOCKER_IMAGE" \
    .

  if [ $? -eq 0 ]; then
    echo -e "${GREEN}Successfully built $DOCKER_IMAGE${NC}"
  else
    echo -e "${RED}Failed to build Docker image${NC}" >&2
    exit 1
  fi
}

# Check if image exists
check_image() {
  if ! docker image inspect "$DOCKER_IMAGE" &>/dev/null; then
    echo -e "${YELLOW}Docker image '$DOCKER_IMAGE' not found${NC}" >&2
    echo "Building the image..." >&2
    build_image
  fi
}

# Start interactive shell
start_shell() {
  check_image

  local work_dir="${MUSSEL_WORK_DIR:-$(pwd)}"
  local docker_args="-it --rm --shm-size=$SHM_SIZE"

  # Pass user/group IDs to container for permission management
  docker_args="$docker_args -e MUSSEL_UID=$(id -u) -e MUSSEL_GID=$(id -g)"

  # Pass environment variables
  docker_args="$docker_args $docker_env_args"

  # Force   # Add GPU support if requested
  if [ "$USE_GPU" = "true" ]; then
    if docker run --rm --gpus all ubuntu:22.04 nvidia-smi &>/dev/null; then
      docker_args="$docker_args --gpus all"
    else
      echo -e "${YELLOW}Warning: GPU support requested but not available${NC}" >&2
    fi
  fi

  echo -e "${GREEN}Starting interactive shell...${NC}"
  echo "Working directory: $work_dir"

  docker run $docker_args \
    -v "$work_dir:/data" \
    -w /data \
    "$DOCKER_IMAGE" \
    /bin/bash
}

# Run a Mussel command
run_command() {
  local command=$1
  shift

  check_image

  local work_dir="${MUSSEL_WORK_DIR:-$(pwd)}"
  local docker_args="--rm --shm-size=$SHM_SIZE"

  # Pass user/group IDs to container for permission management
  docker_args="$docker_args -e MUSSEL_UID=$(id -u) -e MUSSEL_GID=$(id -g)"

  # Pass environment variables
  docker_args="$docker_args $docker_env_args"

  # Add GPU support if requested
  if [ "$USE_GPU" = "true" ]; then
    if docker run --rm --gpus all ubuntu:22.04 nvidia-smi &>/dev/null 2>&1; then
      docker_args="$docker_args --gpus all"
    else
      echo -e "${YELLOW}Warning: GPU support requested but not available, running on CPU${NC}" >&2
    fi
  fi

  # Run the command
  docker run $docker_args \
    -v "$work_dir:/data" \
    -w /data \
    "$DOCKER_IMAGE" \
    "$command" "$@"
}

# Main script logic
main() {
  check_docker
  check_docker_daemon

  # Handle no arguments
  if [ $# -eq 0 ]; then
    show_help
    exit 0
  fi

  local command=$1
  shift

  case "$command" in
  help | --help | -h)
    show_help
    ;;
  build)
    build_image
    ;;
  shell)
    start_shell
    ;;
  tessellate | tessellate_extract_features | filter_tessellate | extract_features | create_class_embeddings | annotate | cache_tiles | export_tiles | filter_features | merge_annotation_features | linear_probe_benchmark | save_model)
    run_command "$command" "$@"
    ;;
  *)
    echo -e "${RED}Error: Unknown command '$command'${NC}" >&2
    echo "Run '$(basename "$0") help' for usage information" >&2
    exit 1
    ;;
  esac
}

# Run main function
main "$@"
